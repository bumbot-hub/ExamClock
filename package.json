{
  "name": "examclock",
  "version": "2.0.0",
  "description": "An app for examination centres to show time to candidates",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bumbot-hub/ExamClock.git"
  },
  "author": "bumbot-hub",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bumbot-hub/ExamClock/issues"
  },
  "homepage": "https://github.com/bumbot-hub/ExamClock#readme",
  "devDependencies": {
    "electron": "^38.3.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.github.bumbot-hub.examclock",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "productName": "ExamClock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/images/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/images/icon.icns"
    }
  }
}